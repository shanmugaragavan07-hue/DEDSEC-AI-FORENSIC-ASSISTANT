# GEMINI_API_KEY: Used server-side for Gemini 3.8 Flash facial profile extraction
# and Gemini 3.5 Transcribe voice-to-text transcription.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where DEDSEC is hosted.
APP_URL="http://localhost:3000"

# ADMIN_EMAILS: Comma-separated list of authorised administrator emails.
ADMIN_EMAILS="shanmugaragavan07@gmail.com"

# SESSION_SECRET: Server-side secret used to sign session tokens.
SESSION_SECRET="change_me_in_production"

# --- OPTIONAL: SMTP EMAIL PROVIDER (Genuine Email OTP & Password Reset) ---
# Leave blank in local development if no SMTP server is configured; DEDSEC will
# transparently indicate that email OTP delivery is inactive rather than faking codes.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DEDSEC Security <no-reply@dedsec.studio>"

# --- OPTIONAL: AUTHORISED INDIAN MERCHANT GATEWAY (Razorpay / Cashfree) ---
# Leave blank in development to run in transparent Sandbox Mode without live charges.
PAYMENT_GATEWAY_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""

# --- OPTIONAL: ALTERNATIVE / LOCAL AI IMAGE PROVIDERS ---
# By default, DEDSEC uses open-source community diffusion (AI Horde anonymous key 0000000000)
# with server-side monochrome graphite processing so zero upfront API spend is required.
AI_HORDE_API_KEY="0000000000"
LOCAL_SD_URL=""
HUGGINGFACE_API_KEY=""
